# Copy to .env for local (non-Docker) runs: cp .env.example .env
# Inside docker compose these values are set by the compose file itself.

# Port the HTTP service listens on.
PORT=3000

# Connection string used by the service AND by `npm run db:migrate`.
DATABASE_URL=postgres://payment:payment@localhost:5432/payment_flow

# Separate database used by `npm test` (created automatically by the
# docker/db init script). Tests truncate this database, never DATABASE_URL.
TEST_DATABASE_URL=postgres://payment:payment@localhost:5432/payment_flow_test

# Maximum size of the PostgreSQL connection pool (one connection is checked
# out per in-flight request/transaction).
DATABASE_POOL_MAX=10

# Longest a single SQL statement may run before PostgreSQL cancels it. Keeps a
# stuck query from holding its pool connection forever.
DATABASE_STATEMENT_TIMEOUT_MS=5000

# Longest a request waits for a free pool connection before giving up. Prevents
# requests hanging when every connection is already checked out.
DATABASE_CONNECTION_TIMEOUT_MS=5000

# "development" | "test" | "production"
NODE_ENV=development